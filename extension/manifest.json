{
  "manifest_version": 3,
  "name": "Tailor Assist",
  "version": "0.10.14409",
  "description": "Fills job applications from your own profile, drafts free-text answers with a local model, and never submits.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "notifications",
    "offscreen",
    "scripting",
    "activeTab",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Tailor Assist",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://*.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://jobs.eu.lever.co/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.myworkdaysite.com/*",
        "https://www.google.com/about/careers/*",
        "https://jobs.ashbyhq.com/*",
        "https://*.smartrecruiters.com/*",
        "https://*.icims.com/*",
        "https://*.taleo.net/*",
        "https://*.oraclecloud.com/hcmUI/CandidateExperience/*",
        "https://*.successfactors.com/career*",
        "https://*.successfactors.eu/career*",
        "https://*.csod.com/ux/ats/*",
        "https://*.jobvite.com/*",
        "https://apply.workable.com/*",
        "https://*.bamboohr.com/careers/*",
        "https://*.recruitee.com/*",
        "https://*.teamtailor.com/*",
        "https://*.applytojob.com/*",
        "https://*.breezy.hr/*",
        "https://ats.rippling.com/*",
        "https://*.avature.net/*",
        "https://*.ultipro.com/*",
        "https://recruiting.paylocity.com/*",
        "https://workforcenow.adp.com/*",
        "https://myjobs.adp.com/*",
        "https://*.dayforcehcm.com/*",
        "https://*.pinpointhq.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "panel.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.12twenty.com/*"
      ],
      "js": [
        "school_board.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "https://boards.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://*.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "https://jobs.eu.lever.co/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.myworkdaysite.com/*",
    "https://www.google.com/about/careers/*",
    "https://jobs.ashbyhq.com/*",
    "https://*.smartrecruiters.com/*",
    "https://*.icims.com/*",
    "https://*.taleo.net/*",
    "https://*.oraclecloud.com/hcmUI/CandidateExperience/*",
    "https://*.successfactors.com/career*",
    "https://*.successfactors.eu/career*",
    "https://*.csod.com/ux/ats/*",
    "https://*.jobvite.com/*",
    "https://apply.workable.com/*",
    "https://*.bamboohr.com/careers/*",
    "https://*.recruitee.com/*",
    "https://*.teamtailor.com/*",
    "https://*.applytojob.com/*",
    "https://*.breezy.hr/*",
    "https://ats.rippling.com/*",
    "https://*.avature.net/*",
    "https://*.ultipro.com/*",
    "https://recruiting.paylocity.com/*",
    "https://workforcenow.adp.com/*",
    "https://myjobs.adp.com/*",
    "https://*.dayforcehcm.com/*",
    "https://*.pinpointhq.com/*",
    "https://*/*"
  ]
}
